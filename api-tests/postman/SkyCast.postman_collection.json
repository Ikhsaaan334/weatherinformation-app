{
  "info": {
    "name": "SkyCast API (token auth)",
    "description": "Decoupled Laravel JSON API (/api/*) with Sanctum bearer-token auth. The collection pre-request script attaches Authorization: Bearer {{token}} once you log in. Run 01 Login (admin) first; baseUrl already includes the /api prefix.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "const token = pm.environment.get('token');",
          "if (token) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Login (admin)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] },
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login returns a token', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('token');",
              "  pm.expect(body.user.roles).to.include('admin');",
              "  pm.environment.set('token', body.token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Dashboard",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/dashboard", "host": ["{{baseUrl}}"], "path": ["dashboard"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns weatherData array', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().weatherData).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Cities - List",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/cities?search=", "host": ["{{baseUrl}}"], "path": ["cities"], "query": [{ "key": "search", "value": "" }] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns a paginator with a can flag', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.cities).to.have.property('data');",
              "  pm.expect(body.can).to.have.property('manage_cities');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Cities - Create (admin)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/cities", "host": ["{{baseUrl}}"], "path": ["cities"] },
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Yogyakarta\",\n  \"state\": \"DIY\",\n  \"country\": \"ID\",\n  \"lat\": -7.7956,\n  \"lon\": 110.3695\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('admin creates a city', function () {",
              "  pm.response.to.have.status(201);",
              "  const city = pm.response.json().city;",
              "  pm.expect(city).to.have.property('id');",
              "  pm.environment.set('newCityId', city.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Cities - Update (admin)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/cities/{{newCityId}}", "host": ["{{baseUrl}}"], "path": ["cities", "{{newCityId}}"] },
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Yogyakarta (updated)\",\n  \"country\": \"ID\",\n  \"lat\": -7.7956,\n  \"lon\": 110.3695\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('admin updates the city', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().city.name).to.eql('Yogyakarta (updated)');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Cities - Delete (admin)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/cities/{{newCityId}}", "host": ["{{baseUrl}}"], "path": ["cities", "{{newCityId}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('admin deletes the city', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 City Weather",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/cities/{{cityId}}/weather", "host": ["{{baseUrl}}"], "path": ["cities", "{{cityId}}", "weather"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns city and weather', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('city');",
              "  pm.expect(body).to.have.property('weather');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Admin - List Users",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/admin/users?search=", "host": ["{{baseUrl}}"], "path": ["admin", "users"], "query": [{ "key": "search", "value": "" }] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns users and roles', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.users).to.have.property('data');",
              "  pm.expect(body.roles).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Admin - Update Role",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/admin/users/{{targetUserId}}/role", "host": ["{{baseUrl}}"], "path": ["admin", "users", "{{targetUserId}}", "role"] },
        "body": { "mode": "raw", "raw": "{\n  \"role\": \"user\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('admin changes a role', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().message).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Logout",
      "request": {
        "method": "POST",
        "header": [],
        "url": { "raw": "{{baseUrl}}/logout", "host": ["{{baseUrl}}"], "path": ["logout"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('logout succeeds', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.environment.set('token', '');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/register", "host": ["{{baseUrl}}"], "path": ["register"] },
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"postman.tester@example.com\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('registration returns a token and user role', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('token');",
              "  pm.expect(body.user.roles).to.include('user');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Login (user)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] },
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('user login returns a token', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.user.roles).to.include('user');",
              "  pm.environment.set('token', body.token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "13 [user] Create City is forbidden",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/cities", "host": ["{{baseUrl}}"], "path": ["cities"] },
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Should Fail\",\n  \"country\": \"ID\",\n  \"lat\": 0,\n  \"lon\": 0\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('regular user is forbidden', function () {",
              "  pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "14 [user] Admin Users is forbidden",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin", "users"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('regular user is forbidden', function () {",
              "  pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
