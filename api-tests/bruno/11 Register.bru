meta {
  name: 11 Register
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno Tester",
    "email": "bruno.tester@example.com",
    "password": "password",
    "password_confirmation": "password"
  }
}

docs {
  Registers a new account (auto-assigned the "user" role) and returns a token + user.
  Emails are unique: change the email between runs or expect 422.
}

tests {
  test("registration returns a token and user role", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody()).to.have.property('token');
    expect(res.getBody().user.roles).to.include('user');
  });
}
