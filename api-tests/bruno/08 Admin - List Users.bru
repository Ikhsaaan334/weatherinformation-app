meta {
  name: 08 Admin - List Users
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/admin/users?search=
  body: none
  auth: none
}

params:query {
  search:
}

docs {
  Admin-only. Paginated users with their roles, plus the list of assignable roles.
}

tests {
  test("returns users and roles", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().users).to.have.property('data');
    expect(res.getBody().roles).to.be.an('array');
  });
}
