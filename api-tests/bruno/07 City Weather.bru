meta {
  name: 07 City Weather
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/cities/{{cityId}}/weather
  body: none
  auth: none
}

docs {
  Returns the city and its current weather (from Open-Meteo). Uses the seeded
  cityId (1), which is not touched by the create/delete steps.
}

tests {
  test("returns city and weather", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property('city');
    expect(res.getBody()).to.have.property('weather');
  });
}
