meta {
  name: 00 Bootstrap
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/login
  body: none
  auth: none
}

docs {
  Run this first. It loads the login page as HTML so the collection script can grab
  the CSRF cookie (XSRF-TOKEN) and the Inertia asset version. No login happens here.
}

tests {
  test("got a CSRF token", function () {
    expect(bru.getVar('xsrfToken')).to.be.a('string').and.not.empty;
  });
}
