meta {
  name: 01 Login (admin)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  // Capture the bearer token so every later request is authenticated as admin.
  const body = res.getBody();
  if (body && body.token) {
    bru.setVar('token', body.token);
  }
}

docs {
  Logs in the seeded admin and stores the returned token in the `token` variable.
  Bad credentials return 422.
}

tests {
  test("login returns a token", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property('token');
    expect(res.getBody().user.roles).to.include('admin');
  });
}
