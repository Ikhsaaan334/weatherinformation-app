meta {
  name: 04 Cities - Create (admin)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/cities
  body: json
  auth: none
}

body:json {
  {
    "name": "Yogyakarta",
    "state": "DIY",
    "country": "ID",
    "lat": -7.7956,
    "lon": 110.3695
  }
}

script:post-response {
  // Remember the new city's id so the Update/Delete requests act on it
  // (instead of mutating seeded data).
  const body = res.getBody();
  if (body && body.city && body.city.id) {
    bru.setVar('newCityId', body.city.id);
  }
}

docs {
  Admin-only. Returns 201 with the created city. A non-admin gets 403; invalid data 422.
}

tests {
  test("admin creates a city", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().city).to.have.property('id');
  });
}
