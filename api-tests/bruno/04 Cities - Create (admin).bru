meta {
  name: 04 Cities - Create (admin)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/cities
  body: json
  auth: none
}

body:json {
  {
    "name": "Yogyakarta",
    "state": "DIY",
    "country": "ID",
    "lat": -7.7956,
    "lon": 110.3695
  }
}

docs {
  Admin-only. Success returns a redirect (status < 400). A non-admin would get 403,
  invalid data would get 422.
}

tests {
  test("admin can create (not forbidden, not invalid)", function () {
    expect(res.getStatus()).to.not.equal(403);
    expect(res.getStatus()).to.not.equal(422);
    expect(res.getStatus()).to.be.below(400);
  });
}
