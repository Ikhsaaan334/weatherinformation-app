meta {
  name: 03 Cities - List
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/cities?search=
  body: none
  auth: none
}

params:query {
  search:
}

docs {
  Paginated list of cities plus a `can.manage_cities` flag for the current user.
}

tests {
  test("returns a paginator with a can flag", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property('cities');
    expect(body.cities).to.have.property('data');
    expect(body.can).to.have.property('manage_cities');
  });
}
