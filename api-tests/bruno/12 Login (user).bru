meta {
  name: 12 Login (user)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

script:post-response {
  // Overwrite the token with the regular user's, for the forbidden checks below.
  const body = res.getBody();
  if (body && body.token) {
    bru.setVar('token', body.token);
  }
}

docs {
  Logs in the seeded non-admin user and stores their token for the negative tests.
}

tests {
  test("user login returns a token", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().user.roles).to.include('user');
  });
}
