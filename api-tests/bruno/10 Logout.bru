meta {
  name: 10 Logout
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/logout
  body: none
  auth: none
}

script:post-response {
  // The token is now revoked server-side; drop it locally too.
  if (res.getStatus() === 200) {
    bru.setVar('token', '');
  }
}

docs {
  Revokes the current access token (the admin token captured in step 01).
}

tests {
  test("logout succeeds", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
