meta {
  name: 09 Admin - Update Role
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/admin/users/{{targetUserId}}/role
  body: json
  auth: none
}

body:json {
  {
    "role": "user"
  }
}

docs {
  Sets the role of user {{targetUserId}}. Valid roles: "admin", "user". An unknown
  role returns 422; trying to change your own role returns 422 with a message.
}

tests {
  test("admin changes a role", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().message).to.be.a('string');
  });
}
