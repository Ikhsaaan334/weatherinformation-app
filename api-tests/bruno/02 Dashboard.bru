meta {
  name: 02 Dashboard
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/dashboard
  body: none
  auth: none
}

docs {
  Returns the dashboard weather payload for the authenticated user.
}

tests {
  test("returns weatherData array", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property('weatherData');
    expect(res.getBody().weatherData).to.be.an('array');
  });
}
