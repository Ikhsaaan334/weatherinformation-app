meta {
  name: 05 Cities - Update (admin)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/cities/{{newCityId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "Yogyakarta (updated)",
    "country": "ID",
    "lat": -7.7956,
    "lon": 110.3695
  }
}

docs {
  Admin-only. Updates the city created in step 04. Returns 200 with the city.
}

tests {
  test("admin updates the city", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().city.name).to.equal("Yogyakarta (updated)");
  });
}
